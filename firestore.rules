rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isVioraAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.superAdmin == true
          || request.auth.token.role in ["admin", "super_admin"]

        );
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function ownsIncomingDoc() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function ownsExistingUserIdDoc() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingUserIdDoc() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingAnyUserDoc() {
      return signedIn()
        && (
          resource.data.uid == request.auth.uid
          || resource.data.userId == request.auth.uid
        );
    }

    function ownsIncomingAnyUserDoc() {
      return signedIn()
        && (
          request.resource.data.uid == request.auth.uid
          || request.resource.data.userId == request.auth.uid
        );
    }

    function ownsDocIdPrefix(docId) {
      return signedIn() && docId.matches(request.auth.uid + "_.*");
    }

    function ownsExistingOwnerUserDoc() {
      return signedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    function ownsIncomingOwnerUserDoc() {
      return signedIn() && request.resource.data.ownerUserId == request.auth.uid;
    }

    // Owner identity must not change on updates, including when a document
    // contains both uid and userId fields.
    function ownerFieldsUnchanged() {
      return request.resource.data.get("uid", null) == resource.data.get("uid", null)
        && request.resource.data.get("userId", null) == resource.data.get("userId", null)
        && request.resource.data.get("ownerUserId", null) == resource.data.get("ownerUserId", null);
    }

    function existingOwnerNotForeign() {
      return (resource.data.get("uid", null) == null || resource.data.get("uid", null) == request.auth.uid)
        && (resource.data.get("userId", null) == null || resource.data.get("userId", null) == request.auth.uid);
    }

    function incomingOwnerNotForeign() {
      return (request.resource.data.get("uid", null) == null || request.resource.data.get("uid", null) == request.auth.uid)
        && (request.resource.data.get("userId", null) == null || request.resource.data.get("userId", null) == request.auth.uid);
    }

    function ownerUserNotForeign(data) {
      return data.get("ownerUserId", null) == null || data.get("ownerUserId", null) == request.auth.uid;
    }

    function canCreateOwnedDoc(docId) {
      return incomingOwnerNotForeign() && ownerUserNotForeign(request.resource.data)
        && (ownsIncomingAnyUserDoc() || ownsDocIdPrefix(docId));
    }

    function canUpdateOwnedDoc(docId) {
      return ownerFieldsUnchanged() && existingOwnerNotForeign() && incomingOwnerNotForeign()
        && ownerUserNotForeign(resource.data) && ownerUserNotForeign(request.resource.data)
        && (ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId))
        && (ownsIncomingAnyUserDoc() || ownsDocIdPrefix(docId));
    }

    function canUpdateOwnedDocWithoutPrefix() {
      return ownerFieldsUnchanged() && existingOwnerNotForeign() && incomingOwnerNotForeign()
        && ownsExistingAnyUserDoc()
        && ownsIncomingAnyUserDoc();
    }

    // Only a fixed set of non-privileged profile fields is client-writable.
    // New server-managed fields are denied by default.
    function userEditableFields() {
      return ["displayName", "fullName", "firstName", "lastName",
        "photoURL", "photoUrl", "avatarUrl", "phoneNumber", "gender",
        "dateOfBirth", "height", "weight", "heightCm", "weightKg",
        "fitnessGoal", "activityLevel", "onboardingCompleted",
        "updatedAt", "serverUpdatedAt", "language", "preferredLanguage",
        "timezone", "city", "country", "mobile", "age", "goal",
        "stressLevel", "acceptedTerms", "termsAcceptedAt", "waterGoalMl",
        "aiCoachEnabled", "notificationsEnabled"];
    }

    // Admin and entitlement fields must only be modified by trusted server code.
    function userProtectedFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userEditableFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "uid", "role", "accessRole", "isAdmin", "admin", "superAdmin",
        "premium", "isPremium", "premiumTier", "subscriptionStatus",
        "entitlements", "accountStatus", "adminCreatedBy", "adminCreatedAt"
      ]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isVioraAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "email", "displayName", "fullName", "firstName", "lastName", "photoURL", "photoUrl", "avatarUrl", "phoneNumber", "gender", "dateOfBirth", "height", "weight", "heightCm", "weightKg", "fitnessGoal", "activityLevel", "onboardingCompleted", "createdAt", "updatedAt", "serverUpdatedAt", "language", "preferredLanguage", "timezone", "city", "country", "mobile", "age", "goal", "stressLevel", "acceptedTerms", "termsAcceptedAt", "waterGoalMl", "aiCoachEnabled", "notificationsEnabled", "isDeleted"]);
      allow update: if isVioraAdmin() || (isOwner(uid) && userProtectedFieldsUnchanged());
      allow delete: if false;
    }

    match /userSettings/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /dailyStats/{docId} {
      allow read: if (ownsDocIdPrefix(docId) && existingOwnerNotForeign() && ownerUserNotForeign(resource.data)) || ownsExistingAnyUserDoc();
      allow create: if canCreateOwnedDoc(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow delete: if false;
    }

    match /hydrationLogs/{docId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsExistingDoc() && ownsIncomingDoc() && ownerFieldsUnchanged();
      allow delete: if false;
    }

    match /sleepLogs/{docId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsExistingDoc() && ownsIncomingDoc() && ownerFieldsUnchanged();
      allow delete: if false;
    }

    match /yogaSessions/{docId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsExistingDoc() && ownsIncomingDoc() && ownerFieldsUnchanged();
      allow delete: if false;
    }

    match /musicSessions/{docId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsExistingDoc() && ownsIncomingDoc() && ownerFieldsUnchanged();
      allow delete: if false;
    }

    match /activities/{docId} {
      allow read: if ownsExistingAnyUserDoc();
      allow update: if canUpdateOwnedDocWithoutPrefix();
      allow create: if ownsIncomingAnyUserDoc();
      allow delete: if false;
    }

    match /journalEntries/{docId} {
      allow read: if ownsExistingAnyUserDoc();
      allow create: if ownsIncomingAnyUserDoc();
      allow update: if canUpdateOwnedDocWithoutPrefix();
      allow delete: if false;
    }

    match /aiConversations/{docId} {
      allow read: if ownsExistingAnyUserDoc();
      allow create: if ownsIncomingAnyUserDoc();
      allow update: if canUpdateOwnedDocWithoutPrefix();
      allow delete: if false;
    }

    match /aiMemory/{docId} {
      allow read: if ownsExistingAnyUserDoc();
      allow update: if canUpdateOwnedDocWithoutPrefix();
      allow create: if ownsIncomingAnyUserDoc();
      allow delete: if false;
    }

    match /conversationSummaries/{docId} {
      allow read: if ownsExistingAnyUserDoc();
      allow update: if canUpdateOwnedDocWithoutPrefix();
      allow create: if ownsIncomingAnyUserDoc();
      allow delete: if false;
    }

    match /aiRequestLogs/{docId} {
      allow create, read, update, delete: if false;
    }

    match /userWellnessProfiles/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /wellnessIntelligence/{docId} {
      allow read: if ownsExistingAnyUserDoc() || (ownsDocIdPrefix(docId) && existingOwnerNotForeign() && ownerUserNotForeign(resource.data));
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /wellnessIntelligenceSnapshots/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /wellnessGoals/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || (ownsDocIdPrefix(docId) && existingOwnerNotForeign() && ownerUserNotForeign(resource.data));
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /wellnessHabits/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /habitCompletions/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /reminderSettings/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /notifications/{docId} {
      allow read: if ownsExistingAnyUserDoc();
      allow update: if canUpdateOwnedDocWithoutPrefix();
      allow create: if ownsIncomingAnyUserDoc();
      allow delete: if false;
    }

    match /nutritionEntries/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /nutritionSummaries/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /nutritionGoals/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /moodEntries/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /moodCheckIns/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /mentalWellnessSummaries/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /mentalWellnessGoals/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /subscriptions/{docId} {
      allow read: if ownsExistingAnyUserDoc() || isVioraAdmin();
      // Premium entitlements must be written by trusted server code only.
      // Firebase Admin SDK bypasses Firestore Security Rules.
      allow create, update: if false;
      allow delete: if false;
    }

    match /payments/{docId} {
      allow read: if ownsExistingAnyUserDoc() || isVioraAdmin();
      // Client-side writes cannot be trusted to confirm a payment.
      allow create, update: if false;
      allow delete: if false;
    }

    match /premiumFeatures/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /premiumProgramEntitlements/{docId} {
      allow read: if ownsExistingAnyUserDoc();
      allow create, update, delete: if false;
    }

    match /privacySettings/{docId} {
      allow read: if ownsExistingAnyUserDoc() || isOwner(docId);
      allow update: if isOwner(docId) || canUpdateOwnedDocWithoutPrefix();
      allow create: if ownsIncomingAnyUserDoc() || isOwner(docId);
      allow delete: if false;
    }

    match /securitySettings/{docId} {
      allow read: if ownsExistingAnyUserDoc() || isOwner(docId);
      allow update: if isOwner(docId) || canUpdateOwnedDocWithoutPrefix();
      allow create: if ownsIncomingAnyUserDoc() || isOwner(docId);
      allow delete: if false;
    }

    match /accountDeletionRequests/{docId} {
      allow read: if ownsExistingAnyUserDoc() || isOwner(docId);
      // Request status is controlled by the authenticated callable backend.
      allow create, update: if false;
      allow delete: if false;
    }

    match /wellnessReports/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /nutritionReports/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /mentalWellnessReports/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /goalReports/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /reportExports/{docId} {
      allow read: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
      allow delete: if false;
    }

    match /voiceCommands/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /voiceSessions/{docId} {
      allow read, delete: if ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if canUpdateOwnedDoc(docId);
      allow create: if canCreateOwnedDoc(docId);
    }

    match /voicePreferences/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }


    match /familyGroups/{docId} {
      allow read: if ownsExistingOwnerUserDoc() || ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if ownerFieldsUnchanged() && (ownsExistingOwnerUserDoc() || ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId)) && (ownsIncomingOwnerUserDoc() || ownsIncomingAnyUserDoc() || ownsDocIdPrefix(docId));
      allow create: if ownerUserNotForeign(request.resource.data) && incomingOwnerNotForeign() && (ownsIncomingOwnerUserDoc() || ownsIncomingAnyUserDoc() || ownsDocIdPrefix(docId));
      allow delete: if false;
    }

    match /familyMembers/{docId} {
      allow read, delete: if ownsExistingOwnerUserDoc() || ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if ownerFieldsUnchanged() && (ownsExistingOwnerUserDoc() || ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId)) && (ownsIncomingOwnerUserDoc() || ownsIncomingAnyUserDoc() || ownsDocIdPrefix(docId));
      allow create: if ownsIncomingOwnerUserDoc() || ownsIncomingAnyUserDoc() || ownsDocIdPrefix(docId);
    }

    match /familyInvites/{docId} {
      allow read: if ownsExistingOwnerUserDoc() || ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow update: if ownerFieldsUnchanged() && (ownsExistingOwnerUserDoc() || ownsExistingAnyUserDoc() || ownsDocIdPrefix(docId)) && (ownsIncomingOwnerUserDoc() || ownsIncomingAnyUserDoc() || ownsDocIdPrefix(docId));
      allow create: if ownsIncomingOwnerUserDoc() || ownsIncomingAnyUserDoc() || ownsDocIdPrefix(docId);
      allow delete: if false;
    }

    match /betaFeedback/{docId} {
      allow read: if ownsExistingAnyUserDoc() || isVioraAdmin();
      allow update: if isVioraAdmin() || canUpdateOwnedDocWithoutPrefix();
      allow create: if ownsIncomingAnyUserDoc();
      allow delete: if false;
    }

    match /clientErrorLogs/{docId} {
      allow read: if ownsExistingAnyUserDoc() || isVioraAdmin();
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == null);
      allow update: if isVioraAdmin();
      allow delete: if false;
    }

    match /appSettings/{docId} {
      allow read: if true;
      allow create, update: if isVioraAdmin();
      allow delete: if false;
    }

    match /adminContent/{docId} {
      allow read: if true;
      allow create, update: if isVioraAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
