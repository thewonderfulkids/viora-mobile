rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function accountWritable() {
      return signedIn() && !firestore.exists(/databases/(default)/documents/accountDeletionLocks/$(request.auth.uid));
    }
    function isVioraAdmin() { return signedIn() && (request.auth.token.get("admin", false) == true || request.auth.token.get("superAdmin", false) == true || request.auth.token.get("role", "") in ["admin", "super_admin"]); }
    match /profile-photos/{uid}/{fileName} { allow read: if signedIn() && request.auth.uid == uid; allow create: if accountWritable() && request.auth.uid == uid && resource == null && request.resource.size < 5*1024*1024 && request.resource.contentType.matches('image/.*'); allow update, delete: if false; }
    match /viora-media/{category}/videos/{fileName} { allow read: if true; allow write: if accountWritable() && isVioraAdmin() && request.resource.size < 500*1024*1024 && request.resource.contentType.matches('video/.*'); }
    match /viora-media/{category}/audio/{fileName} { allow read: if true; allow write: if accountWritable() && isVioraAdmin() && request.resource.size < 100*1024*1024 && request.resource.contentType.matches('audio/.*'); }
    match /viora-media/{category}/thumbnails/{fileName} { allow read: if true; allow write: if accountWritable() && isVioraAdmin() && request.resource.size < 10*1024*1024 && request.resource.contentType.matches('image/.*'); }
  }
}
